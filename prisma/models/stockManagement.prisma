model StockManagements {
  id            String              @id @default(uuid()) @db.Uuid
  inventoryId   String              @db.Uuid
  orderId       String?             @db.Uuid
  orderItemId   String?             @db.Uuid
  performedById String              @db.Uuid
  type          StockManagementType
  quantity      Int
  stockBefore   Int
  stockAfter    Int
  note          String?             @db.VarChar(255)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt()

  inventory   Inventories @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  order       Orders?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem   OrderItems? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  performedBy Users       @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([inventoryId, createdAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([type])
}
