model Refunds {
  id                   String       @id @default(uuid()) @db.Uuid
  orderId              String       @unique @db.Uuid
  paymentId            String       @unique @db.Uuid
  refundNumber         String       @db.VarChar(10)
  amount               Decimal      @db.Decimal(10,2)
  currency             String       @db.VarChar(5)
  description          String?      @db.VarChar(255)
  status               RefundStatus @default(PENDING)
  gatewayRefundId      String?      @db.Text()
  transactionReference String?      @db.Text()
  processedBy          String
  processedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt()

  order   Orders   @relation(fields: [orderId], references: [id] , onDelete : Restrict)
  payment Payments @relation(fields: [paymentId], references: [id] , onDelete : Restrict)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}
