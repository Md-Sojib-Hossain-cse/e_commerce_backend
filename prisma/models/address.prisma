model Addresses {
    id String @id @default(uuid())
    user Users @relation(fields : [userId] , references : [id])
    userId String
    name String @db.VarChar(50)
    phone String @db.VarChar(15)
    addressType AddressType
    addressLine String @db.VarChar(100)
    city String @db.VarChar(30)
    district String @db.VarChar(30)
    postalCode String? @db.VarChar(6)
    country String  @db.VarChar(30)
    landmark String? @db.Text()
    deliveryInstructions String @db.VarChar(150)
    isDefaultBilling Boolean? @default(false)
    isDefaultShipping Boolean? @default(false)
    createdAt DateTime? @default(now())
    updatedAt DateTime? @updatedAt()

    @@index([userId])
    @@index([userId , isDefaultBilling])
    @@index([userId , isDefaultShipping])
}