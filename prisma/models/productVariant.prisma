model ProductVariants {
    id String @id @default(uuid())
    productId String
    sku String @db.VarChar(20)
    barcode String? @db.Text()
    color String? @db.VarChar(15)
    size String? @db.VarChar(5)
    colorCode String? @db.VarChar(10)
    price Int 
    salePrice Int?
    stock Int
    reservedStock Int
    lowStockThreshold Int
    image String @db.Text()
    status ProductVariantStatus  @default(INACTIVE)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    @@index([productId])
    @@index([status])
}