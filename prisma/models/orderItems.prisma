model OrderItems {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  variantId      String   @db.Uuid
  description    String?  @db.VarChar(255)
  categories     String
  productName    String   @db.VarChar(100)
  productSlug    String   @db.VarChar(110)
  productImage   String   @db.Text()
  sku            String   @db.VarChar(50)
  variantName    String   @db.VarChar(100)
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10,2)
  discountAmount Decimal  @db.Decimal(10,2) @default(0)
  totalPrice     Decimal  @db.Decimal(10,2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()

  order   Orders          @relation(fields: [orderId], references: [id] , onDelete : Cascade)
  variant ProductVariants @relation(fields: [variantId], references: [id] , onDelete : Cascade)

  stockManagements StockManagements[]

  @@index([orderId])
  @@index([variantId])
}
