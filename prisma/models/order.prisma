model Orders {
  id             String      @id @default(uuid()) @db.Uuid
  orderNumber    String      @db.VarChar(15)
  userId         String      @db.Uuid
  customerName   String      @db.VarChar(50)
  customerEmail  String      @db.VarChar(50)
  customerPhone  String      @db.VarChar(15)
  payment        Payments?
  shipping       Shippings?
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountAmount Decimal     @db.Decimal(10, 2)
  shippingCost   Decimal     @db.Decimal(10, 2)
  taxAmount      Decimal     @db.Decimal(10, 2)
  totalAmount    Decimal     @db.Decimal(10, 2)
  customerNote   String?     @db.VarChar(200)
  adminNote      String?     @db.VarChar(200)
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt()

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  couponUsages     CouponUsages?
  refunds          Refunds?
  shippingAddress  OrderAddresses?
  items            OrderItems[]
  stockManagements StockManagements[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
